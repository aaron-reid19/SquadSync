PORT=4100
NODE_ENV=development
IDENTITY_ISSUER=http://localhost:4100
IDENTITY_AUDIENCE=squadsync-api
IDENTITY_KEY_ID=dev-identity-key
# Required outside development. Use PEM values with literal \n characters.
# IDENTITY_PRIVATE_KEY_PEM=
# IDENTITY_PUBLIC_KEY_PEM=
IDENTITY_INTERNAL_TOKEN=change-me
ACCESS_TOKEN_TTL_SECONDS=900
IDENTITY_COOKIE_NAME=squadsync-access
# Use __Host-squadsync-access in production over HTTPS.
