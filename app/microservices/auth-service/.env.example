PORT=4001
NODE_ENV=development
DATABASE_URL=postgresql://auth_app:change-me@localhost:5432/auth_db
DATABASE_SSL=false
DB_POOL_MAX=10
IDENTITY_SERVICE_URL=http://localhost:4100
SQUAD_SERVICE_URL=http://localhost:4101
IDENTITY_INTERNAL_TOKEN=replace-with-a-long-random-shared-secret
INTERNAL_SERVICE_TOKEN=replace-with-another-long-random-shared-secret
IDENTITY_COOKIE_NAME=squadsync-access
ACCESS_TOKEN_TTL_SECONDS=86400
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
APP_URL=http://localhost:3000
MAIL_FROM=SquadSync <no-reply@squadsync.app>
# Leave SMTP_URL out in development: reset links print in the server terminal.
# SMTP_URL=smtps://user:password@smtp.example.com:465
