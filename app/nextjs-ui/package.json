{
  "name": "squadsync",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:gateway": "npm --prefix ../microservices/api-gateway run dev",
    "dev:api": "npm --prefix ../microservices/auth-service run dev",
    "dev:all": "concurrently -n web,gateway,auth -c blue,magenta,green \"npm run dev\" \"npm run dev:gateway\" \"npm run dev:api\"",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "leaflet": "^1.9.4",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.0.1",
    "typescript": "^5.5.3"
  }
}
