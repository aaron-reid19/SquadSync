rules_version = '2';
// MVP rules: open while the app uses the hard-coded admin login.
// Before any real users: switch the app to Firebase Auth and restrict reads/writes to Squad members.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }
  }
}
