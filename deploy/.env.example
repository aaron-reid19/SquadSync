# PostgreSQL runs on the local server, outside the application containers.
DATABASE_URL=postgresql://squadsync:change-me@host.docker.internal:5432/squadsync
DATABASE_SSL=false
DB_POOL_MAX=10

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
APP_URL=http://localhost:3000
MAIL_FROM=SquadSync <no-reply@squadsync.app>
# SMTP_URL=smtps://user:password@smtp.example.com:465

# Identity service scaffold
IDENTITY_ISSUER=http://identity-service:4100
IDENTITY_AUDIENCE=squadsync-api
IDENTITY_KEY_ID=home-server-identity-key
IDENTITY_INTERNAL_TOKEN=change-me
ACCESS_TOKEN_TTL_SECONDS=900
IDENTITY_COOKIE_NAME=squadsync-access
# Store persistent PEM keys in the server environment or a secret manager.
# IDENTITY_PRIVATE_KEY_PEM=
# IDENTITY_PUBLIC_KEY_PEM=

# Notification worker scaffold
SERVICE_TOKEN=change-me
